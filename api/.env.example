# Copy to .env. Never commit .env or serviceAccountKey.json.
PORT=3000
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Alternative for hosting: FIREBASE_SERVICE_ACCOUNT={...JSON...}
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Add one email if both administrators share one login, or two emails for separate accounts.
ADMIN_EMAILS=your-email@example.com
